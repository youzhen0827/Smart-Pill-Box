<?xml version="1.0" encoding="utf-8"?>
<TabHost xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/tabhost"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/topbar_blue"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💊 智慧藥盒管家"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="目前時間"
                android:textColor="@color/header_subtitle"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvHeaderConnection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Django API：尚未連線"
                android:textColor="@color/header_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tab_bg"
            android:fillViewport="true"
            android:scrollbars="none">

            <TabWidget
                android:id="@android:id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </HorizontalScrollView>

        <FrameLayout
            android:id="@android:id/tabcontent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 今日提醒 -->
            <LinearLayout
                android:id="@+id/tabToday"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStatTotal"
                        style="@style/StatsCardText"
                        android:backgroundTint="@color/palette_blue"
                        android:text="0\n今日任務"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvStatTaken"
                        style="@style/StatsCardText"
                        android:backgroundTint="@color/palette_aqua"
                        android:text="0\n已完成"
                        android:textColor="@color/ok_green" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStatPending"
                        style="@style/StatsCardText"
                        android:backgroundTint="@color/palette_mint"
                        android:text="0\n追蹤中"
                        android:textColor="@color/warn_orange" />

                    <TextView
                        android:id="@+id/tvStatMissed"
                        style="@style/StatsCardText"
                        android:backgroundTint="@color/palette_sage"
                        android:text="0\n需要確認"
                        android:textColor="@color/danger_red" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/card_background"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="💊 今日早／中／晚任務狀態" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="顏色依 Django API 的今日提醒狀態顯示；實體開盒事件依早／中／晚三格回傳。"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:columnCount="3">

                        <TextView android:id="@+id/tvSlot1" style="@style/SlotBoxStyle" android:text="早\n未排程" />
                        <TextView android:id="@+id/tvSlot2" style="@style/SlotBoxStyle" android:text="中\n未排程" />
                        <TextView android:id="@+id/tvSlot3" style="@style/SlotBoxStyle" android:text="晚\n未排程" />
                    </GridLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/tvTodayTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="今日服藥任務"
                        android:textColor="@color/topbar_blue"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnRefresh"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/secondary_button"
                        android:text="重新載入"
                        android:textAllCaps="false"
                        android:textColor="@color/topbar_blue"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTodayStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="4dp"
                    android:text="請先在連線設定填入長輩姓名與 API 網址。"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerReminderList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="10dp" />
            </LinearLayout>

            <!-- 新增提醒 -->
            <ScrollView
                android:id="@+id/tabAdd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_background"
                        android:orientation="vertical">

                        <TextView style="@style/SectionTitle" android:text="➕ 新增臨時服藥" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="臨時服藥只執行一次；長期重複用藥請建立固定排程。"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/editAddUserName"
                            style="@style/FormInput"
                            android:hint="長輩姓名，例如：王阿公"
                            android:inputType="textPersonName" />

                        <EditText
                            android:id="@+id/editAddAge"
                            style="@style/FormInput"
                            android:hint="年齡，例如：72"
                            android:inputType="number" />

                        <EditText
                            android:id="@+id/editAddMedicine"
                            style="@style/FormInput"
                            android:hint="藥品名稱或 FDA 學名，例如：metformin"
                            android:inputType="text" />

                        <Button
                            android:id="@+id/btnVoiceAddMedicine"
                            style="@style/SecondaryButton"
                            android:text="語音輸入藥品名稱" />

                        <EditText
                            android:id="@+id/editAddDate"
                            style="@style/FormInput"
                            android:clickable="true"
                            android:focusable="false"
                            android:hint="服藥日期"
                            android:inputType="date" />

                        <Button
                            android:id="@+id/btnPickAddDate"
                            style="@style/SecondaryButton"
                            android:text="選擇服藥日期" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="服藥時間"
                            android:textColor="@color/text_secondary"
                            android:textSize="17sp" />

                        <EditText
                            android:id="@+id/editAddTime"
                            style="@style/FormInput"
                            android:clickable="true"
                            android:focusable="false"
                            android:hint="服藥時間，例如 08:00"
                            android:inputType="time" />

                        <Button
                            android:id="@+id/btnPickAddTime"
                            style="@style/SecondaryButton"
                            android:text="選擇服藥時間" />

                        <EditText
                            android:id="@+id/editAddDose"
                            style="@style/FormInput"
                            android:hint="劑量，例如：1"
                            android:inputType="text" />

                        <EditText
                            android:id="@+id/editAddHint"
                            style="@style/FormInput"
                            android:hint="提醒內容，例如：飯後服用"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLines="3" />

                        <Button
                            android:id="@+id/btnVoiceAddHint"
                            style="@style/SecondaryButton"
                            android:text="語音輸入提醒內容" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="藥盒時段（早／中／晚）"
                            android:textColor="@color/text_secondary"
                            android:textSize="17sp" />

                        <Button
                            android:id="@+id/btnPickAddSlot"
                            style="@style/SecondaryButton"
                            android:text="早" />

                        <EditText
                            android:id="@+id/editAddDeviceId"
                            style="@style/FormInput"
                            android:hint="裝置 ID，例如：pillbox-01"
                            android:inputType="text" />

                        <Button
                            android:id="@+id/btnCreateReminder"
                            style="@style/PrimaryButton"
                            android:text="寫入 Django 提醒" />

                        <TextView
                            android:id="@+id/tvCreateStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="尚未送出"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- 固定排程 -->
            <ScrollView
                android:id="@+id/tabSchedule"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_background"
                        android:orientation="vertical">

                        <TextView style="@style/SectionTitle" android:text="固定服藥排程" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="適合每天或每週重複服藥。資料會保存在 Django，關閉 App 後仍會保留。"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/editScheduleUserName"
                            style="@style/FormInput"
                            android:hint="長輩姓名"
                            android:inputType="textPersonName" />

                        <EditText
                            android:id="@+id/editScheduleAge"
                            style="@style/FormInput"
                            android:hint="年齡"
                            android:inputType="number" />

                        <EditText
                            android:id="@+id/editScheduleMedicine"
                            style="@style/FormInput"
                            android:hint="藥品名稱，例如：降血壓藥"
                            android:inputType="text" />

                        <Button
                            android:id="@+id/btnVoiceScheduleMedicine"
                            style="@style/SecondaryButton"
                            android:text="語音輸入藥品名稱" />

                        <EditText
                            android:id="@+id/editScheduleTime"
                            style="@style/FormInput"
                            android:clickable="true"
                            android:focusable="false"
                            android:hint="服藥時間，例如 08:00"
                            android:inputType="time" />

                        <Button
                            android:id="@+id/btnPickScheduleTime"
                            style="@style/SecondaryButton"
                            android:text="選擇服藥時間" />

                        <Button
                            android:id="@+id/btnPickScheduleSlot"
                            style="@style/SecondaryButton"
                            android:text="早" />

                        <Button
                            android:id="@+id/btnPickScheduleWeekdays"
                            style="@style/SecondaryButton"
                            android:text="星期 1,2,3,4,5,6,7" />

                        <EditText
                            android:id="@+id/editScheduleDose"
                            style="@style/FormInput"
                            android:hint="劑量，例如：1"
                            android:inputType="text" />

                        <EditText
                            android:id="@+id/editScheduleHint"
                            style="@style/FormInput"
                            android:hint="提醒內容，例如：飯後服用"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLines="3" />

                        <Button
                            android:id="@+id/btnVoiceScheduleHint"
                            style="@style/SecondaryButton"
                            android:text="語音輸入提醒內容" />

                        <EditText
                            android:id="@+id/editScheduleDeviceId"
                            style="@style/FormInput"
                            android:hint="裝置 ID，例如：pillbox-01"
                            android:inputType="text" />

                        <Button
                            android:id="@+id/btnSaveSchedule"
                            style="@style/PrimaryButton"
                            android:text="儲存固定排程" />

                        <Button
                            android:id="@+id/btnClearSchedule"
                            style="@style/SecondaryButton"
                            android:text="改新增排程" />

                        <Button
                            android:id="@+id/btnReloadSchedules"
                            style="@style/SecondaryButton"
                            android:text="重新載入排程" />

                        <TextView
                            android:id="@+id/tvScheduleStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="尚未載入"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerScheduleList"
                        android:layout_width="match_parent"
                        android:layout_height="360dp"
                        android:clipToPadding="false"
                        android:paddingTop="8dp"
                        android:paddingBottom="10dp" />
                </LinearLayout>
            </ScrollView>

            <!-- AI Agent 追蹤 -->
            <LinearLayout
                android:id="@+id/tabAgent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:orientation="vertical">

                    <TextView style="@style/SectionTitle" android:text="AI Agent 追蹤" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="只列出等待開盒、已再次提醒或需要照護者確認的任務。"
                        android:textColor="@color/text_secondary"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvAgentStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="尚未載入追蹤資料"
                        android:textColor="@color/topbar_blue"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerAgentList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp" />
            </LinearLayout>

            <!-- 語音衛教 -->
            <ScrollView
                android:id="@+id/tabQa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_background"
                        android:orientation="vertical">

                        <TextView style="@style/SectionTitle" android:text="🎙️ 語音衛教" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="語音衛教由 APP 獨立完成：直接查詢 FDA 公開藥品資料，並在手機內翻成易懂中文。網頁連線只用於排程同步。"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/editQaDrug"
                            style="@style/FormInput"
                            android:hint="藥品學名或 Product NDC，例如：metformin"
                            android:inputType="text" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="常見問題"
                            android:textColor="@color/text_secondary"
                            android:textSize="17sp" />

                        <Spinner
                            android:id="@+id/spinnerQaPrompt"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/input_background" />

                        <EditText
                            android:id="@+id/editQaQuestion"
                            style="@style/FormInput"
                            android:gravity="top|start"
                            android:hint="例如：為什麼要吃這顆藥？有什麼副作用？"
                            android:inputType="textCapSentences|textMultiLine"
                            android:minHeight="96dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="回答／朗讀語言"
                            android:textColor="@color/text_secondary"
                            android:textSize="17sp" />

                        <Spinner
                            android:id="@+id/spinnerQaLanguage"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/input_background" />

                        <Button
                            android:id="@+id/btnSpeechInput"
                            style="@style/SecondaryButton"
                            android:text="使用手機語音輸入問題" />

                        <Button
                            android:id="@+id/btnAskQa"
                            style="@style/PrimaryButton"
                            android:text="由 APP 查詢並回答" />

                        <Button
                            android:id="@+id/btnSpeakAnswer"
                            style="@style/SecondaryButton"
                            android:enabled="false"
                            android:text="朗讀回答" />

                        <TextView
                            android:id="@+id/tvQaStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="APP 獨立衛教已就緒；首次翻譯需下載手機語言模型"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/card_background"
                        android:orientation="vertical">

                        <TextView style="@style/SectionTitle" android:text="依問題整理的 Agent 回答" />

                        <TextView
                            android:id="@+id/tvQaAnswer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="回答會顯示在這裡。"
                            android:textColor="@color/text_primary"
                            android:textIsSelectable="true"
                            android:lineSpacingExtra="6dp"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/tvQaEvidence"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:autoLink="web"
                            android:linksClickable="true"
                            android:text="資料證據：尚無"
                            android:textColor="@color/text_secondary"
                            android:textIsSelectable="true"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- 連線設定 -->
            <ScrollView
                android:id="@+id/tabSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_background"
                        android:orientation="vertical">

                        <TextView style="@style/SectionTitle" android:text="☁️ Django API 連線設定" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Android 模擬器使用 10.0.2.2；實體手機需填入執行 Django 電腦的區域網路 IP。"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/editBaseUrl"
                            style="@style/FormInput"
                            android:hint="http://10.0.2.2:8000/api/v1/"
                            android:inputType="textUri" />

                        <EditText
                            android:id="@+id/editApiToken"
                            style="@style/FormInput"
                            android:hint="DEVICE_API_TOKEN"
                            android:inputType="textPassword" />

                        <EditText
                            android:id="@+id/editDefaultUser"
                            style="@style/FormInput"
                            android:hint="預設長輩姓名"
                            android:inputType="textPersonName" />

                        <EditText
                            android:id="@+id/editDefaultDevice"
                            style="@style/FormInput"
                            android:hint="預設裝置 ID，例如：pillbox-01"
                            android:inputType="text" />

                        <Button
                            android:id="@+id/btnSaveSettings"
                            style="@style/PrimaryButton"
                            android:text="儲存設定" />

                        <Button
                            android:id="@+id/btnTestConnection"
                            style="@style/SecondaryButton"
                            android:text="測試 Django API" />

                        <TextView
                            android:id="@+id/tvSettingsStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="尚未測試"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="18dp"
                            android:background="@color/palette_aqua" />

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_marginTop="12dp"
                            android:text="帳號與密碼" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="開啟安全的網頁完成註冊、登入或密碼重設。"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/btnOpenRegister"
                            style="@style/SecondaryButton"
                            android:text="註冊帳號" />

                        <Button
                            android:id="@+id/btnOpenLogin"
                            style="@style/SecondaryButton"
                            android:text="登入帳號" />

                        <Button
                            android:id="@+id/btnForgotPassword"
                            style="@style/PrimaryButton"
                            android:text="忘記密碼" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/card_background"
                        android:orientation="vertical">

                        <TextView style="@style/SectionTitle" android:text="🧪 感測器 API 測試" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="目前尚未接硬體，可先用這裡模擬早／中／晚任一格開盒事件；未來 ESP32 或 Raspberry Pi 感測器會送出相同資料。"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />

                        <Spinner
                            android:id="@+id/spinnerSensorSlot"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background" />

                        <Button
                            android:id="@+id/btnSendSensorOpen"
                            style="@style/PrimaryButton"
                            android:text="送出「藥盒開啟」測試事件" />

                        <TextView
                            android:id="@+id/tvSensorStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="尚未送出事件"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</TabHost>
