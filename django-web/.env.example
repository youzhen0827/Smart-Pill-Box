DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,*
DJANGO_CSRF_TRUSTED_ORIGINS=

DB_NAME=smartpillbox
DB_USER=smartpill
DB_PASSWORD=smartpill_dev_password
DB_ROOT_PASSWORD=root_dev_password
MYSQL_PORT=3307
WEB_PORT=8000

# 密碼重設郵件；正式使用時請改為 SMTP backend 並填入郵件主機。
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=智慧藥盒 <no-reply@localhost>

# Android / Raspberry Pi 共用。正式部署務必更換。
DEVICE_API_TOKEN=smartpill-dev-token

# openFDA 不強制 API key；大量或固定使用時可填官方免費 key。
OPENFDA_API_KEY=
OPENFDA_TIMEOUT=20

# 基本 compose 留空；啟用 docker-compose.translation.yml 時會自動覆寫。
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
AGENT_POLL_SECONDS=15
LOG_LEVEL=INFO
